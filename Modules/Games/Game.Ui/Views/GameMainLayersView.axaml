<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:data="clr-namespace:Game.Domain.Data;assembly=Game.Domain"
             prism:ViewModelLocator.AutoWireViewModel="True"
             x:Class="Game.Ui.Views.GameMainLayersView"
             d:DesignHeight="400">

    <Grid>
        <!-- Main Content -->
        <TransitioningContentControl prism:RegionManager.RegionName="{x:Static data:GameRegionNameService.GameMainLayerRegionName}"
                                     Margin="3">
            <TransitioningContentControl.PageTransition>
                <PageSlide Orientation="Horizontal"
                           Duration="0:00:00.250" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

        <!-- Top Content -->
        <TransitioningContentControl prism:RegionManager.RegionName="{x:Static data:GameRegionNameService.GameTopLayerRegionName}"
                                     Margin="3">
            <TransitioningContentControl.PageTransition>
                <PageSlide Orientation="Horizontal"
                           Duration="0:00:00.250" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>

    </Grid>

</UserControl>